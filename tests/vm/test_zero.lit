; output: 1001
; result: 0
; a cbr on eq or ne with 0 is a TEST of the other value (lower.c): both
; comparisons, the 0 on either side, on a value that is 0 and on one
; that is not
func @f : fn(i64) -> void {
b0(v0: i64):
  v1 = iconst i64 0
  v2 = icmp.eq i1 v0, v1
  cbr v2, b1, b2
b1:
  v3 = iconst i64 1
  call.rt void print_i64(v3)
  br b3
b2:
  v4 = iconst i64 0
  call.rt void print_i64(v4)
  br b3
b3:
  v5 = iconst i64 0
  v6 = icmp.ne i1 v5, v0
  cbr v6, b4, b5
b4:
  v7 = iconst i64 1
  call.rt void print_i64(v7)
  ret
b5:
  v8 = iconst i64 0
  call.rt void print_i64(v8)
  ret
}

func @main : fn() -> i64 {
b0:
  v0 = iconst i64 0
  v1 = iconst i64 5
  call void @f(v0)
  call void @f(v1)
  call.rt void print_nl()
  ret v0
}
