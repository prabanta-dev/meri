; output: 1
; trap: 49
; check (icmp cc a, b) is one instruction (CHKCC): every comparison
; that holds, signed and unsigned, then an unsigned one that does not
func @main : fn() -> i64 {
b0:
  v0 = iconst i64 -1
  v1 = iconst i64 1
  v2 = iconst i64 -2
  v3 = icmp.ult i1 v1, v0
  check v3, 40
  v4 = icmp.ugt i1 v0, v1
  check v4, 41
  v5 = icmp.ule i1 v1, v0
  check v5, 42
  v6 = icmp.uge i1 v0, v1
  check v6, 43
  v7 = icmp.slt i1 v2, v0
  check v7, 44
  v8 = icmp.sle i1 v0, v1
  check v8, 45
  v9 = icmp.sgt i1 v1, v2
  check v9, 46
  v10 = icmp.sge i1 v0, v2
  check v10, 47
  v11 = icmp.eq i1 v0, v0
  check v11, 48
  call.rt void print_i64(v1)
  call.rt void print_nl()
  v12 = icmp.ult i1 v0, v1
  check v12, 49
  ret v1
}
