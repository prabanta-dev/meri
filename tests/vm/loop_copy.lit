; output: 21
; result: 0
; the end of a loop is LOOP only if the jump back copies nothing else
; (lower.c): here it swaps v2 and v3 too, five times
func @main : fn() -> i64 {
b0:
  v0 = iconst i64 0
  v1 = iconst i64 1
  v9 = iconst i64 2
  br b1(v0, v1, v9)
b1(v4: i64, v2: i64, v3: i64):
  v5 = iconst i64 5
  v6 = icmp.eq i1 v4, v5
  cbr v6, b3, b2
b2:
  v7 = add i64 v4, v1
  br b1(v7, v3, v2)
b3:
  call.rt void print_i64(v2)
  call.rt void print_i64(v3)
  call.rt void print_nl()
  ret v0
}
