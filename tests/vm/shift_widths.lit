; output: 2
; output: 32767
; output: -1
; output: 2
; output: 2
; output: 64
; output: -2
; result: 0
; a shift counts modulo the width of its type, i8 and i16 too (IR 9):
; 1 << 9 in i8 is 1 << 1; 0xffff >> 17 in i16 is >> 1; -128 >> 15 in i8
; is >> 7; i32 and i64 past their width the same
func @main : fn() -> i64 {
b0:
  v0 = iconst i8 1
  v1 = iconst i8 9
  v2 = shl i8 v0, v1
  v3 = sext i64 v2
  call.rt void print_i64(v3)
  call.rt void print_nl()
  v4 = iconst i16 -1
  v5 = iconst i16 17
  v6 = lshr i16 v4, v5
  v7 = sext i64 v6
  call.rt void print_i64(v7)
  call.rt void print_nl()
  v8 = iconst i8 -128
  v9 = iconst i8 15
  v10 = ashr i8 v8, v9
  v11 = sext i64 v10
  call.rt void print_i64(v11)
  call.rt void print_nl()
  v12 = iconst i32 1
  v13 = iconst i32 33
  v14 = shl i32 v12, v13
  v15 = sext i64 v14
  call.rt void print_i64(v15)
  call.rt void print_nl()
  v16 = iconst i64 1
  v17 = iconst i64 65
  v18 = shl i64 v16, v17
  call.rt void print_i64(v18)
  call.rt void print_nl()
  v19 = iconst i16 128
  v20 = iconst i16 -15
  v21 = ashr i16 v19, v20
  v22 = sext i64 v21
  call.rt void print_i64(v22)
  call.rt void print_nl()
  v23 = iconst i64 -8
  v24 = iconst i64 -62
  v25 = ashr i64 v23, v24
  call.rt void print_i64(v25)
  call.rt void print_nl()
  v26 = iconst i64 0
  ret v26
}
