; output: 1
; result: 0
; a comparison with a constant right before its cbr, but used in another
; block too: not fused, so its constant stays in a register (not JLTK)
func @f : fn(i64) -> void {
b0(v0: i64):
  v1 = iconst i64 5
  v2 = icmp.slt i1 v0, v1
  cbr v2, b1, b2
b1:
  v3 = zext i64 v2
  call.rt void print_i64(v3)
  ret
b2:
  ret
}

func @main : fn() -> i64 {
b0:
  v0 = iconst i64 4
  call void @f(v0)
  call.rt void print_nl()
  v1 = iconst i64 0
  ret v1
}
