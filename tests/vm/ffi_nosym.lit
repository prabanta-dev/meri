; link: symbol meri_no_such_symbol not found in library c
; a symbol that is not there stops the program before its first
; instruction, with its name and its library; so does one of them that is
; never called
extern @f : fn() -> i64 = "meri_no_such_symbol" in "c"

func @main : fn() -> i64 {
b0:
  v0 = iconst i64 0
  ret v0
}
