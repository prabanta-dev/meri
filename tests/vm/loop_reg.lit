; trap: 7
; the end of a loop is LOOP only if the sum goes where x was (lower.c):
; here x (v5) goes back unchanged and v5 + 1 goes to the other
; parameter, so v5 and v4 never meet and the loop ends in NOMEM (1 MiB a
; turn, 64 MiB for the test). A LOOP would add to v5 and meet v4 at 0
func @main : fn() -> i64 {
b0:
  v0 = iconst i64 0
  v1 = iconst i64 -3
  v2 = iconst i64 1
  v3 = iconst i64 1048576
  br b1(v0, v1)
b1(v4: i64, v5: i64):
  v6 = call.rt ptr mem_alloc(v3)
  v7 = icmp.eq i1 v5, v4
  cbr v7, b3, b2
b2:
  v8 = add i64 v5, v2
  br b1(v8, v5)
b3:
  ret v0
}
