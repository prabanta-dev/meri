; trap: 11
; the mod of INT32_MIN by -1 (SMOD32) is DIVZERO, as srem: in C the
; division would overflow
func @mod32 : fn(i32, i32) -> i32 {
b0(v0: i32, v1: i32):
  v2 = iconst i32 0
  v3 = srem i32 v0, v1
  v4 = icmp.ne i1 v3, v2
  v5 = xor i32 v3, v1
  v6 = icmp.slt i1 v5, v2
  v7 = and i1 v4, v6
  v8 = add i32 v3, v1
  v9 = select i32 v7, v8, v3
  ret v9
}

func @main : fn() -> i64 {
b0:
  v0 = iconst i32 -2147483648
  v1 = iconst i32 -1
  v2 = call i32 @mod32(v0, v1)
  v3 = sext i64 v2
  ret v3
}
