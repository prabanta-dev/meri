; output: 1
; output: ss
; output: 2
; output: 3
; output: ss
; output: 4
; output: 100 index out of range 1
; result: 0
; strings: 0
; traps out of the body of a par_for (2 and 4, a string held in each): every
; index runs, then the lowest index's leaves par_for with the words of the
; module and the position the body gave it (pos 1); the other is dropped
language "luxia"
message 100 "index out of range"
pos 1 "p.luxia" 2 5
pos 2 "p.luxia" 4 5

func @body : fn(ptr, i64) -> void {
b0(v0: ptr, v1: i64):
  v2 = sconst str "s"
  v3 = call.rt str str_concat(v2, v2)
  call.rt void print_i64(v1)
  call.rt void print_nl()
  v4 = iconst i64 2
  v5 = icmp.eq i1 v1, v4
  v6 = iconst i64 4
  v7 = icmp.eq i1 v1, v6
  v8 = xor i1 v5, v7
  v9 = xor i1 v8, v8
  cbr v5, b1, b2
b1:
  check v9, 100 !1
  ret
b2:
  cbr v7, b3, b4
b3:
  check v9, 100 !2
  ret
b4:
  call.rt void print_str(v3)
  call.rt void print_nl()
  ret
}

func @main : fn() -> i64 {
b0:
  v0 = faddr ptr @body
  v1 = null ptr
  v2 = iconst i64 1
  v3 = iconst i64 4
  br b1
b1 handler b2:
  call.rt void par_for(v0, v1, v2, v3)
  v4 = iconst i64 1
  ret v4
b2(v5: i32, v6: i32, v7: str):
  v8 = sext i64 v5
  call.rt void print_i64(v8)
  v9 = iconst i32 32
  call.rt void print_char(v9)
  call.rt void print_str(v7)
  call.rt void print_char(v9)
  v10 = sext i64 v6
  call.rt void print_i64(v10)
  call.rt void print_nl()
  v11 = iconst i64 0
  ret v11
}
