; the range check of Luxia (sge i, lo; sle i, hi; and; check) fused into
; one instruction, with constant limits (CHKRK) and with limits in
; registers (CHKR); the array access after it (sub i, 1; addr; load)
; fused too: a[1..3] of i64 read at 1, 2, 3, then a[4] stops
pos 1 "t.luxia" 5 9
pos 2 "t.luxia" 7 9
func @get : fn(ptr, i64, i64, i64) -> i64 {
b0(v0: ptr, v1: i64, v2: i64, v3: i64):
  v4 = icmp.sge i1 v1, v2 !2
  v5 = icmp.sle i1 v1, v3 !2
  v6 = and i1 v4, v5 !2
  check v6, 100 !2
  v7 = iconst i64 1
  v8 = sub i64 v1, v7
  v9 = addr ptr v0, v8, 8, 0
  v10 = load i64 v9
  ret v10
}

func @main : fn() -> i64 {
  slot 24 align 8
b0:
  v0 = slot ptr $0
  v1 = iconst i64 12
  v2 = iconst i64 0
  br b1(v2, v1)
b1(v3: i64, v4: i64):
