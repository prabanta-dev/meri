  v6 = iconst i64 3
  v7 = add i64 v3, v5
  v8 = icmp.sge i1 v7, v5 !1
  v9 = icmp.sle i1 v7, v6 !1
  v10 = and i1 v8, v9 !1
  check v10, 100 !1
  v11 = sub i64 v7, v5
  v12 = addr ptr v0, v11, 8, 0
  store v4, v12
  v13 = add i64 v4, v5
  v14 = icmp.slt i1 v7, v6
  cbr v14, b1(v7, v13), b2(v5)
b2(v15: i64):
  v16 = call i64 @get(v0, v15, v5, v6)
  call.rt void print_i64(v16)
  call.rt void print_nl()
  v17 = add i64 v15, v5
  v18 = iconst i64 5
  v19 = icmp.slt i1 v17, v18
  cbr v19, b2(v17), b3
b3:
  v20 = iconst i64 0
  ret v20
}
