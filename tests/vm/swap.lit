; output: 2
; output: 1
; output: 10
; output: 20
; output: 30
; output: 30
; result: 1
; parameters swapped and rotated by the arguments of a jump: a parallel
; copy with cycles, on the edge of a cbr whose comparison is folded in
func @rotate : fn() -> i64 {
b0:
  v0 = iconst i64 10
  v1 = iconst i64 20
  v2 = iconst i64 30
  v3 = iconst i64 0
  br b1(v0, v1, v2, v3)
b1(v4: i64, v5: i64, v6: i64, v7: i64):
  call.rt void print_i64(v4)
  call.rt void print_nl()
  v8 = iconst i64 1
  v9 = add i64 v7, v8
  v10 = iconst i64 3
  v11 = icmp.slt i1 v9, v10
  cbr v11, b1(v5, v6, v4, v9), b2
b2:
  ret v4
}

func @main : fn() -> i64 {
b0:
  v0 = iconst i64 1
  v1 = iconst i64 2
  v2 = iconst i64 0
  br b1(v0, v1, v2)
b1(v3: i64, v4: i64, v5: i64):
  call.rt void print_i64(v3)
  call.rt void print_nl()
  v6 = iconst i64 1
  v7 = add i64 v5, v6
  v8 = iconst i64 3
  v9 = icmp.slt i1 v7, v8
  cbr v9, b1(v4, v3, v7), b2
b2:
  v10 = call i64 @rotate()
  call.rt void print_i64(v10)
  call.rt void print_nl()
  ret v3
}
