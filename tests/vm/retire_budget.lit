; trap: 7
; needs: slabs
; a place of mem_alloc freed at the last generation of its address is
; retired, never given out again: its charge stays with the budget. 65534
; blocks of 256 bytes at one place, then 64 MiB - 255 bytes: they fit the
; 64 MiB of test_vm only if the retired 256 were given back
func @main : fn() -> i64 {
b0:
  v0 = iconst i64 0
  v1 = iconst i64 65534
  v2 = iconst i64 256
  br b1(v0)
b1(v3: i64):
  v4 = icmp.eq i1 v3, v1
  cbr v4, b3, b2
b2:
  v5 = call.rt ptr mem_alloc(v2)
  call.rt void mem_free(v5)
  v6 = iconst i64 1
  v7 = add i64 v3, v6
  br b1(v7)
b3:
  v8 = iconst i64 67108609
  v9 = call.rt ptr mem_alloc(v8)
  v10 = iconst i64 0
  ret v10
}
