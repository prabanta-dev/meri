; stops: badmem
; the arguments the IR checks before come first: a negative length to a
; handle never opened is a wrong module (lir_run calls it so), not the
; trap INVALID_HANDLE
func @main : fn() -> i64 {
  slot 8 align 8
b0:
  v0 = iconst i64 5
  v1 = slot ptr $0
  v2 = iconst i64 -1
  call.rt void file_write(v0, v1, v2)
  v3 = iconst i64 0
  ret v3
}
