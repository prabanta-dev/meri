; output: 400
; result: 0
; 400 small blocks alive at once, then every one checked: ptr_live finds
; a block by its offset in the arena (heap.c: a reciprocal, no division),
; here far into it
func @main : fn() -> i64 {
b0:
  v0 = iconst i64 16
  v1 = null ptr
  v2 = iconst i64 0
  v3 = iconst i64 1
  v4 = iconst i64 400
  br b1(v1, v2)
b1(v5: ptr, v6: i64):
  v7 = call.rt ptr mem_alloc(v0)
  store v5, v7
  v8 = add i64 v6, v3
  v9 = icmp.slt i1 v8, v4
  cbr v9, b1(v7, v8), b2(v7, v2)
b2(v10: ptr, v11: i64):
  v12 = icmp.eq i1 v10, v1
  cbr v12, b4, b3
b3:
  v13 = call.rt i1 ptr_live(v10)
  check v13, 105
  v14 = load ptr v10
  v15 = add i64 v11, v3
  br b2(v14, v15)
b4:
  call.rt void print_i64(v11)
  call.rt void print_nl()
  ret v2
}
