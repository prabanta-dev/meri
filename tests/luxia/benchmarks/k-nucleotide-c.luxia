// The Computer Language Benchmarks Game
// https://salsa.debian.org/benchmarksgame-team/benchmarksgame/
//
// k-nucleotide in Luxia 0, using routines of the language where the
// Python program uses C: the input read whole by readbytes, the lines
// of THREE drawn together with move, the nucleotides made codes 0..3 by
// translate (bytes.translate), the fragments of 1 and 2 nucleotides
// counted by occurrences (bytes.count). The codes are moved at once into
// an array of their own, passed to the routines as the program of Limba
// passes its own. The longer fragments are counted
// in Luxia, as Python counts them in Python: a hash table written by
// hand, with open addressing, made by new and twice as large each time
// it is half full. A fragment of k nucleotides is a key of 2k bits; for
// one k the order of the keys is the alphabetical order of the fragments.
program KNucleotideC;

const
  ChunkSize = 65536;

type
  Bytes = array[Int64 range <>] of Byte;
  BytesRef = ^Bytes;
  Codes = array[Byte] of Byte;
  // a slot of the table: a count of 0 is a free one
  Entry = record
    key: Bits64;
    count: Int64;
  end;
  Table = array[Int64 range <>] of Entry;
  TableRef = ^Table;

var
  data: BytesRef;      // the whole input, then the codes of THREE
  size: Int64 := 0;
  first: Int64 := 0;   // the codes of THREE: from first,
  len: Int64 := 0;     // len of them
  code: Codes;

// the input, whole, in data; twice as large each time it is full
procedure ReadAll();
begin
  data := new(Bytes range 0..ChunkSize - 1);
  while true do
    if size = length(data^) then
      var d := new(Bytes range 0..2 * length(data^) - 1);
      move(data^, 0, d^, 0, size);
      dispose(data);
      data := d;
    end;
    var want := length(data^) - size;
    var n := readbytes(data^, size, want);
    size := size + n;
    exit when n < want;   // fewer only at the end
  end;
end ReadAll;

// the newline that ends the line from p, or size
function LineEnd(p: Int64): Int64;
begin
  var e := p;
  while e < size and data[e] <> 10 do
    e := e + 1;
  end;
  return e;
end LineEnd;

// whether the line from p begins with s
function Begins(p: Int64; s: String): Boolean;
begin
  if size - p < length(s) then
    return false;
  end;
  for var i := 1 to length(s) do
    if data[p + i - 1] <> s[i] then
      return false;
    end;
  end;
  return true;
end Begins;

// the lines of THREE drawn together where it starts, made codes
procedure FindThree();
begin
  var pos: Int64 := 0;
  while pos < size and not Begins(pos, ">THREE") do
    pos := LineEnd(pos) + 1;
  end;
  if pos >= size then
    return;
  end;
  first := LineEnd(pos) + 1;
  var m := first;
  var p := first;
  while p < size and data[p] <> 62 do
    var e := LineEnd(p);
    move(data^, p, data^, m, e - p);
    m := m + (e - p);
    p := e + 1;
  end;
  len := m - first;
  translate(data^, first, len, code);
end FindThree;

// the table twice as large, its keys hashed again; the old one freed
function Grow(old: TableRef): TableRef;
begin
  var t := new(Table range 0..2 * length(old^) - 1);
  var mask := Bits64(length(t^) - 1);
  for var i := low(old^) to high(old^) do
    var e := old[i];
    if e.count <> 0 then
      var p := Int64((e.key * 2654435761) and mask);
      while t[p].count <> 0 do
        p := Int64((Bits64(p) + 1) and mask);
      end;
      t[p] := e;
    end;
  end;
  dispose(old);
  return t;
end Grow;

// counts every fragment of k nucleotides of the sequence in a table of
// 64 slots at first, twice as large each time it is half full
function CountFrames(dna: Bytes; k: Int32): TableRef;
begin
  var t := new(Table range 0..63);
  var mask: Bits64 := 63;
  var filled: Int64 := 0;
  var bits := (Bits64(1) shl (2 * k)) - 1;
  var acc: Bits64 := 0;
  for var i := low(dna) to high(dna) do
    acc := ((acc shl 2) or Bits64(dna[i])) and bits;
    if i - low(dna) >= Int64(k) - 1 then
      var p := Int64((acc * 2654435761) and mask);
      var e := t[p];
      while e.count <> 0 and e.key <> acc do
        p := Int64((Bits64(p) + 1) and mask);
        e := t[p];
      end;
      if e.count = 0 then
        t[p].key := acc;
        t[p].count := 1;
        filled := filled + 1;
        if 2 * filled > length(t^) then
          t := Grow(t);
          mask := Bits64(length(t^) - 1);
        end;
      else
        t[p].count := e.count + 1;
      end;
    end;
  end;
  return t;
end CountFrames;

function Count(k: Bits64; t: TableRef): Int64;
begin
  var mask := Bits64(length(t^) - 1);
  var p := Int64((k * 2654435761) and mask);
  var e := t[p];
  while e.count <> 0 do
    if e.key = k then
      return e.count;
    end;
    p := Int64((Bits64(p) + 1) and mask);
    e := t[p];
  end;
  return 0;
end Count;

function Fragment(k: Bits64; n: Int32): String;
begin
  var s := "";
  for var i := n - 1 downto 0 do
    s := s & copy("ACGT", Int64((k shr (2 * i)) and 3) + 1, 1);
  end;
  return s;
end Fragment;

function KeyOf(s: String): Bits64;
begin
  var k: Bits64 := 0;
  for var i := 1 to length(s) do
    k := (k shl 2) or Bits64(code[s[i]]);
  end;
  return k;
end KeyOf;

// the times of the fragments of 1 or 2 nucleotides, by occurrences: those
// of XY with X <> Y never overlap, so they are all counted; those of XX
// are the X followed by anything, less the XY
procedure Small(dna: Bytes; k: Int32;
                var times: array[Int64 range <>] of Int64);
begin
  var one: array[Int64 range 1..1] of Byte;
  var two: array[Int64 range 1..2] of Byte;
  var singles: array[Int64 range 0..3] of Int64;
  for var x: Int64 := 0 to 3 do
    one[1] := Byte(x);
    singles[x] := occurrences(dna, low(dna), length(dna), one);
  end;
  if k = 1 then
    for var x: Int64 := 0 to 3 do
      times[x] := singles[x];
    end;
    return;
  end;
  for var x: Int64 := 0 to 3 do
    var others: Int64 := 0;
    for var y: Int64 := 0 to 3 do
      if x <> y then
        two[1] := Byte(x);
        two[2] := Byte(y);
        times[4 * x + y] := occurrences(dna, low(dna), length(dna), two);
        others := others + times[4 * x + y];
      end;
    end;
    var followed := singles[x];
    if length(dna) > 0 and Int64(dna[high(dna)]) = x then
      followed := followed - 1;
    end;
    times[5 * x] := followed - others;
  end;
end Small;

// every fragment of k nucleotides with its share, the most frequent first
procedure Frequency(dna: Bytes; k: Int32);
begin
  var total: Int64 := 1;
  for var i := 1 to k do
    total := total * 4;
  end;
  var names: array[Int64 range 0..total - 1] of Bits64;
  var times: array[Int64 range 0..total - 1] of Int64;
  for var i := 0 to total - 1 do
    names[i] := Bits64(i);
  end;
  Small(dna, k, times);
  // insertion sort: more frequent first, then alphabetical
  for var i := 1 to total - 1 do
    var name := names[i];
    var times1 := times[i];
    var j := i - 1;
    while j >= 0 do
      exit when times[j] > times1;
      exit when times[j] = times1 and names[j] < name;
      names[j + 1] := names[j];
      times[j + 1] := times[j];
      j := j - 1;
    end;
    names[j + 1] := name;
    times[j + 1] := times1;
  end;
  var frames := Float64(length(dna) - Int64(k) + 1);
  for var i := 0 to total - 1 do
    writeln(Fragment(names[i], k), " ",
            Float64(times[i]) * 100.0 / frames:0:3);
  end;
  writeln();
end Frequency;

procedure CountFragment(dna: Bytes; s: String);
begin
  var t := CountFrames(dna, Int32(length(s)));
  writeln(Count(KeyOf(s), t), TAB, s);
  dispose(t);
end CountFragment;

begin
  for var b := low(code) to high(code) do
    code[b] := 0;
  end;
  code[65] := 0;   // A
  code[97] := 0;
  code[67] := 1;   // C
  code[99] := 1;
  code[71] := 2;   // G
  code[103] := 2;
  code[84] := 3;   // T
  code[116] := 3;

  ReadAll();
  FindThree();
  var dna: array[Int64 range 1..len] of Byte;
  move(data^, first, dna, 1, len);
  dispose(data);
  Frequency(dna, 1);
  Frequency(dna, 2);
  CountFragment(dna, "GGT");
  CountFragment(dna, "GGTA");
  CountFragment(dna, "GGTATT");
  CountFragment(dna, "GGTATTTTAATT");
  CountFragment(dna, "GGTATTTTAATTTATAGT");
end KNucleotideC.
