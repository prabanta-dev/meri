/*
 * ops.def - the instructions of the Meri VM.
 *
 *   MERI_OP(name, text, format)
 *
 * name    the enumerator is MERI_OP_<name>
 * text    the spelling of the disassembly
 * format  MERI_FMT_* in code.h: which fields the word uses, and whether a
 *         second word follows
 *
 * A register is R[x] of the window of the running function; K[x] is the
 * constant x of the function (64 bits). Integers are kept in their
 * canonical form, sign-extended from their width (0 or 1 for i1); an f32
 * is the 32 bits of its float, zero-extended (insieme_istruzioni.md § 2).
 * The order is the numbering of the bytecode: add at the end.
 */

/* moves and constants */
MERI_OP(MOVE, "move", MERI_FMT_AB)     /* R[A] = R[B] */
MERI_OP(LOADI, "loadi", MERI_FMT_AsBx) /* R[A] = sBx */
MERI_OP(LOADK, "loadk", MERI_FMT_ABx)  /* R[A] = K[Bx] */
MERI_OP(LOADS, "loads", MERI_FMT_ABx)  /* R[A] = string constant Bx */

/* integers of 64 bits (i64 and ptr) */
MERI_OP(ADD, "add", MERI_FMT_ABC)
MERI_OP(SUB, "sub", MERI_FMT_ABC)
MERI_OP(MUL, "mul", MERI_FMT_ABC)
MERI_OP(ADDOV, "add.ov", MERI_FMT_ABC) /* OVERFLOW on signed overflow */
MERI_OP(SUBOV, "sub.ov", MERI_FMT_ABC)
MERI_OP(MULOV, "mul.ov", MERI_FMT_ABC)
MERI_OP(SDIV, "sdiv", MERI_FMT_ABC) /* DIVZERO for 0 and INT_MIN / -1 */
MERI_OP(UDIV, "udiv", MERI_FMT_ABC)
MERI_OP(SREM, "srem", MERI_FMT_ABC)
MERI_OP(UREM, "urem", MERI_FMT_ABC)
MERI_OP(NEG, "neg", MERI_FMT_AB)
MERI_OP(SHL, "shl", MERI_FMT_ABC) /* the count modulo the width */
MERI_OP(LSHR, "lshr", MERI_FMT_ABC)
MERI_OP(ASHR, "ashr", MERI_FMT_ABC)

/* the same on i32, the result sign-extended from 32 bits */
MERI_OP(ADD32, "add32", MERI_FMT_ABC)
MERI_OP(SUB32, "sub32", MERI_FMT_ABC)
MERI_OP(MUL32, "mul32", MERI_FMT_ABC)
MERI_OP(ADDOV32, "add.ov32", MERI_FMT_ABC)
MERI_OP(SUBOV32, "sub.ov32", MERI_FMT_ABC)
MERI_OP(MULOV32, "mul.ov32", MERI_FMT_ABC)
MERI_OP(SDIV32, "sdiv32", MERI_FMT_ABC)
MERI_OP(UDIV32, "udiv32", MERI_FMT_ABC)
MERI_OP(SREM32, "srem32", MERI_FMT_ABC)
MERI_OP(UREM32, "urem32", MERI_FMT_ABC)
MERI_OP(NEG32, "neg32", MERI_FMT_AB)
MERI_OP(SHL32, "shl32", MERI_FMT_ABC)
MERI_OP(LSHR32, "lshr32", MERI_FMT_ABC)
MERI_OP(ASHR32, "ashr32", MERI_FMT_ABC)

/* an integer operation of i1, i8 or i16: X = the IR operation, the bits */
MERI_OP(INTN, "intn", MERI_FMT_ABC_X)

/* bits: the same for every width, on canonical values */
MERI_OP(AND, "and", MERI_FMT_ABC)
MERI_OP(OR, "or", MERI_FMT_ABC)
MERI_OP(XOR, "xor", MERI_FMT_ABC)
MERI_OP(NOT, "not", MERI_FMT_AB) /* not i1 (that is intn) */

/* floats: f64, then f32 */
MERI_OP(FADD, "fadd", MERI_FMT_ABC)
MERI_OP(FSUB, "fsub", MERI_FMT_ABC)
MERI_OP(FMUL, "fmul", MERI_FMT_ABC)
MERI_OP(FDIV, "fdiv", MERI_FMT_ABC)
MERI_OP(FNEG, "fneg", MERI_FMT_AB)
MERI_OP(FMA, "fma", MERI_FMT_ABC_X) /* R[A] = R[B] * R[C] + R[X] */
MERI_OP(FROUND, "fround", MERI_FMT_AB)
MERI_OP(FROUNDA, "fround.away", MERI_FMT_AB)
MERI_OP(FADDF, "fadd.f32", MERI_FMT_ABC)
MERI_OP(FSUBF, "fsub.f32", MERI_FMT_ABC)
MERI_OP(FMULF, "fmul.f32", MERI_FMT_ABC)
MERI_OP(FDIVF, "fdiv.f32", MERI_FMT_ABC)
MERI_OP(FNEGF, "fneg.f32", MERI_FMT_AB)
MERI_OP(FMAF, "fma.f32", MERI_FMT_ABC_X)
MERI_OP(FROUNDF, "fround.f32", MERI_FMT_AB)
MERI_OP(FROUNDAF, "fround.away.f32", MERI_FMT_AB)

/* comparisons giving 0 or 1: signed and unsigned on canonical integers,
   ordered on f64; every other one through CMPX (X = cc, 1 << 8 for f32) */
MERI_OP(EQ, "eq", MERI_FMT_ABC)
MERI_OP(NE, "ne", MERI_FMT_ABC)
MERI_OP(LT, "lt", MERI_FMT_ABC)
MERI_OP(LE, "le", MERI_FMT_ABC)
MERI_OP(LTU, "ltu", MERI_FMT_ABC)
MERI_OP(LEU, "leu", MERI_FMT_ABC)
MERI_OP(FEQ, "feq", MERI_FMT_ABC)
MERI_OP(FLT, "flt", MERI_FMT_ABC)
MERI_OP(FLE, "fle", MERI_FMT_ABC)
MERI_OP(CMPX, "cmpx", MERI_FMT_ABC_X)
MERI_OP(SELECT, "select", MERI_FMT_ABC_X) /* R[A] = R[B] ? R[C] : R[X] */

/* conversions */
MERI_OP(SEXT8, "sext8", MERI_FMT_AB) /* from the low bits of R[B] */
MERI_OP(SEXT16, "sext16", MERI_FMT_AB)
MERI_OP(SEXT32, "sext32", MERI_FMT_AB)
MERI_OP(ZEXT1, "zext1", MERI_FMT_AB)
MERI_OP(ZEXT8, "zext8", MERI_FMT_AB)
MERI_OP(ZEXT16, "zext16", MERI_FMT_AB)
MERI_OP(ZEXT32, "zext32", MERI_FMT_AB)
MERI_OP(I2D, "i2d", MERI_FMT_AB) /* signed 64 bits to f64 */
MERI_OP(I2F, "i2f", MERI_FMT_AB) /* to f32 */
MERI_OP(U2D, "u2d", MERI_FMT_AB) /* unsigned 64 bits */
MERI_OP(U2F, "u2f", MERI_FMT_AB)
MERI_OP(D2F, "d2f", MERI_FMT_AB) /* fptrunc */
MERI_OP(F2D, "f2d", MERI_FMT_AB) /* fpext */
/* any other conversion: X = the IR operation, from, to (types) */
MERI_OP(CONVX, "convx", MERI_FMT_AB_X)

/* memory: the address is R[B] + C */
MERI_OP(LD1, "ld1", MERI_FMT_ABC)
MERI_OP(LD8, "ld8", MERI_FMT_ABC)
MERI_OP(LD16, "ld16", MERI_FMT_ABC)
MERI_OP(LD32, "ld32", MERI_FMT_ABC)
MERI_OP(LDF32, "ldf32", MERI_FMT_ABC) /* the 32 bits, zero-extended */
MERI_OP(LD64, "ld64", MERI_FMT_ABC)
MERI_OP(ST8, "st8", MERI_FMT_ABC) /* store R[A] at R[B] + C */
MERI_OP(ST16, "st16", MERI_FMT_ABC)
MERI_OP(ST32, "st32", MERI_FMT_ABC)
MERI_OP(ST64, "st64", MERI_FMT_ABC)
/* R[A] = R[B] + R[C] * K[X] + K[X + 1], modulo 2^64 */
MERI_OP(ADDR, "addr", MERI_FMT_ABC_X)
MERI_OP(SLOT, "slot", MERI_FMT_ABx)   /* address of slot Bx of the frame */
MERI_OP(GADDR, "gaddr", MERI_FMT_ABx) /* address of global Bx */
MERI_OP(FADDR, "faddr", MERI_FMT_ABx) /* the value of function Bx */
MERI_OP(MEMCPY, "memcpy", MERI_FMT_ABC) /* dst R[A], src R[B], len R[C] */
MERI_OP(MEMSET, "memset", MERI_FMT_ABC) /* byte: the low 8 bits of R[B] */
/* retain (C = 0) and release (C = 1) every str of n = R[B] values of type
   X at p = R[A]; RANGE for a negative n or an overflowing n * size */
MERI_OP(RC, "rc", MERI_FMT_ABC_X)

/* calls: the arguments in R[A], R[A + 1]...; the result in R[A] */
MERI_OP(CALL, "call", MERI_FMT_ABx)     /* function Bx */
MERI_OP(CALLRT, "call.rt", MERI_FMT_ABx) /* runtime function Bx */
MERI_OP(CALLI, "call.ind", MERI_FMT_AB_X) /* callee R[B], X its type */
MERI_OP(CALLX, "call.ext", MERI_FMT_ABx) /* not supported: an error */
MERI_OP(RET, "ret", MERI_FMT_A)
MERI_OP(RET0, "ret0", MERI_FMT_NONE)

/* control: a jump goes to the word after it plus sJ */
MERI_OP(JMP, "jmp", MERI_FMT_sJ)
/* test and jump: the next word is a JMP, taken when the condition is k
   (the field C, or B for TEST), skipped otherwise */
MERI_OP(TEST, "test", MERI_FMT_AkJ) /* R[A] != 0 */
MERI_OP(JEQ, "jeq", MERI_FMT_ABkJ)
MERI_OP(JLT, "jlt", MERI_FMT_ABkJ)
MERI_OP(JLE, "jle", MERI_FMT_ABkJ)
MERI_OP(JLTU, "jltu", MERI_FMT_ABkJ)
MERI_OP(JLEU, "jleu", MERI_FMT_ABkJ)
MERI_OP(JFEQ, "jfeq", MERI_FMT_ABkJ) /* ordered, f64 */
MERI_OP(JFLT, "jflt", MERI_FMT_ABkJ)
MERI_OP(JFLE, "jfle", MERI_FMT_ABkJ)
MERI_OP(TRAP, "trap", MERI_FMT_ABx)   /* the code is K[Bx] */
MERI_OP(CHECK, "check", MERI_FMT_ABx) /* the trap K[Bx] if R[A] is 0 */
MERI_OP(UNREACH, "unreachable", MERI_FMT_NONE)

/* the references of the strings (vm/str.h) */
MERI_OP(SRETAIN, "sretain", MERI_FMT_A)   /* one more on R[A] */
MERI_OP(SRELEASE, "srelease", MERI_FMT_A) /* one less on R[A] */
MERI_OP(LDS, "lds", MERI_FMT_ABC) /* R[A] = the str at R[B] + C, retained */
/* store the str R[A] at R[B] + C: retain it, release the old one */
MERI_OP(STS, "sts", MERI_FMT_ABC)
MERI_OP(RELSLOTS, "relslots", MERI_FMT_NONE) /* release the typed slots */

/* the registers past 255 of a wide function (lower.c): a move with 16-bit
   indices, and the calls whose arguments begin past 255 */
MERI_OP(MOVEW, "movew", MERI_FMT_MOVW)
MERI_OP(CALLW, "callw", MERI_FMT_BxX)
MERI_OP(CALLRTW, "call.rtw", MERI_FMT_BxX)
/* the callee in R[B], the base A | C << 8, X its type */
MERI_OP(CALLIW, "call.indw", MERI_FMT_ABC_X)

/* runtime calls promoted to instructions (lower.c) */
MERI_OP(FSQRT, "fsqrt", MERI_FMT_AB)   /* math_sqrt */
MERI_OP(FMATH, "fmath", MERI_FMT_ABC)  /* the f64 -> f64 function C */
MERI_OP(CHKLIVE, "chklive", MERI_FMT_ABx) /* ptr_live R[A], else trap K[Bx] */

/* fusions of lower.c: a range check (trap X, or B, unless lo <= R[A] <= hi,
   signed; lo, hi in R[B], R[C] or in K[X], K[X + 1]) */
MERI_OP(CHKR, "chkr", MERI_FMT_ABC_X)
MERI_OP(CHKRK, "chkrk", MERI_FMT_ABC_X)
/* load R[A] and store R[A] at R[B] + R[C] * K[X] + K[X + 1] */
MERI_OP(LDX1, "ldx1", MERI_FMT_ABC_X)
MERI_OP(LDX8, "ldx8", MERI_FMT_ABC_X)
MERI_OP(LDX16, "ldx16", MERI_FMT_ABC_X)
MERI_OP(LDX32, "ldx32", MERI_FMT_ABC_X)
MERI_OP(LDXF32, "ldxf32", MERI_FMT_ABC_X)
MERI_OP(LDX64, "ldx64", MERI_FMT_ABC_X)
MERI_OP(STX8, "stx8", MERI_FMT_ABC_X)
MERI_OP(STX16, "stx16", MERI_FMT_ABC_X)
MERI_OP(STX32, "stx32", MERI_FMT_ABC_X)
MERI_OP(STX64, "stx64", MERI_FMT_ABC_X)
/* str_ptr, str_len, print_byte */
MERI_OP(STRPTR, "strptr", MERI_FMT_AB)
MERI_OP(STRLEN, "strlen", MERI_FMT_AB)
MERI_OP(PUTB, "putb", MERI_FMT_A)

/* calls that copy their arguments themselves: the registers follow the
   first word (MERI_FMT_ABxN), the callee's window begins at A */
MERI_OP(CALLN, "calln", MERI_FMT_ABxN)
MERI_OP(CALLRTN, "call.rtn", MERI_FMT_ABxN)
/* print_char: the code point R[A] in UTF-8 */
MERI_OP(PUTC, "putc", MERI_FMT_A)
/* R[A] = R[B] + C: an address with a constant displacement */
MERI_OP(ADDI, "addi", MERI_FMT_ABC)
/* the end of a loop: if R[A] != R[B], R[A] += R[C] (modulo 2^64, or
   2^32 sign-extended) and the JMP after it is taken; else it is skipped */
MERI_OP(LOOP, "loop", MERI_FMT_ABCJ)
MERI_OP(LOOP32, "loop32", MERI_FMT_ABCJ)
/* mem_alloc: R[A] = a zeroed block of R[B] bytes, NOMEM past the budget */
MERI_OP(ALLOC, "alloc", MERI_FMT_AB)
/* a nil check and a live check of R[A]: the traps K[Bx], K[Bx + 1] */
MERI_OP(CHKNL, "chknl", MERI_FMT_ABx)
/* CHKR, then R[X >> 16] = R[A] - R[B]; the trap K[X & 0xffff] */
MERI_OP(CHKRS, "chkrs", MERI_FMT_ABC_X)
/* the trap K[X] unless R[A] cc R[B], an integer comparison (cc = C) */
MERI_OP(CHKCC, "chkcc", MERI_FMT_ABC_X)
/* memcpy (as memmove) and memset of C bytes, C a constant */
MERI_OP(MEMCPYK, "memcpyk", MERI_FMT_ABC)
MERI_OP(MEMSETK, "memsetk", MERI_FMT_ABC)
/* ptr_live: R[A] = 1 if R[B] is the pointer of a block alive, else 0 */
MERI_OP(LIVE, "live", MERI_FMT_AB)
/* a constant sC of 8 bits with a sign, outside loops (inside them the
   constants are in registers before block 0): R[A] = R[B] + sC, modulo
   2^64 or 2^32 sign-extended, or OVERFLOW */
MERI_OP(ADDK, "addk", MERI_FMT_ABsC)
MERI_OP(ADDK32, "addk32", MERI_FMT_ABsC)
MERI_OP(ADDOVK, "add.ovk", MERI_FMT_ABsC)
MERI_OP(ADDOVK32, "add.ovk32", MERI_FMT_ABsC)
/* test and jump on R[A] and sB (signed): the JMP after it taken when the
   condition is k (C) */
MERI_OP(JEQK, "jeqk", MERI_FMT_AsBkJ)
MERI_OP(JLTK, "jltk", MERI_FMT_AsBkJ)
MERI_OP(JLEK, "jlek", MERI_FMT_AsBkJ)
/* return the constant sBx */
MERI_OP(RETK, "retk", MERI_FMT_AsBx)
/* ALLOC of Bx bytes, a constant */
MERI_OP(ALLOCK, "allock", MERI_FMT_ABx)
/* CALLN whose result goes to R[D], D the word after the arguments */
MERI_OP(CALLND, "callnd", MERI_FMT_ABxND)
/* mem_free R[A]: INVALID_FREE if it is not a block alive (0: nothing) */
MERI_OP(FREE, "free", MERI_FMT_A)
/* the mod of Luxia (the sign of the divisor): srem, then + R[C] when the
   rest is not 0 and its sign differs from R[C]'s; DIVZERO as srem */
MERI_OP(SMOD, "smod", MERI_FMT_ABC)
MERI_OP(SMOD32, "smod32", MERI_FMT_ABC)
/* an f64 fmul t = R[B] * R[C] and the fadd, fsub or fmul that uses it,
   with R[X]: two roundings, as the two instructions (not an FMA), the
   operands in the order of the IR (R suffix: R[X] first) */
MERI_OP(FMADD, "fmadd", MERI_FMT_ABC_X)
MERI_OP(FMADDR, "fmaddr", MERI_FMT_ABC_X)
MERI_OP(FMSUB, "fmsub", MERI_FMT_ABC_X)
MERI_OP(FMSUBR, "fmsubr", MERI_FMT_ABC_X)
MERI_OP(FMUL3, "fmul3", MERI_FMT_ABC_X)
MERI_OP(FMUL3R, "fmul3r", MERI_FMT_ABC_X)
/* the end of a loop going down: as LOOP, LOOP32, R[A] -= R[C] */
MERI_OP(LOOPD, "loopd", MERI_FMT_ABCJ)
MERI_OP(LOOPD32, "loopd32", MERI_FMT_ABCJ)
/* a load of i8 zero-extended (the zext its only use): at R[B] + C, and
   at R[B] + R[C] * K[X] + K[X + 1] */
MERI_OP(LDU8, "ldu8", MERI_FMT_ABC)
MERI_OP(LDXU8, "ldxu8", MERI_FMT_ABC_X)
/* sdiv (i64 or i32) by a constant C of 2 to 127, outside loops: no trap
   possible; a power of two by a shift that truncates as sdiv */
MERI_OP(SDIVK, "sdivk", MERI_FMT_ABsC)
/* a range check of the index R[B] (lo in R[X & 0xff], hi in
   R[X >> 8 & 0xff], the trap K[X >> 16]) and the addr after it:
   R[A] = R[C] + R[B] * K[Y] + K[Y + 1] */
MERI_OP(CHKADDR, "chkaddr", MERI_FMT_ABC_XY)
